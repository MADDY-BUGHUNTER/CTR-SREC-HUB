# Copy this file to .env and keep real secrets out of Git.

# Address allowed to call the FastAPI backend.
CORS_ORIGINS=http://127.0.0.1:5500,http://localhost:5500

# Key used to sign login tokens. Replace this in production.
JWT_SECRET=replace-this-with-a-long-random-secret

# Minutes before a login token expires.
JWT_EXPIRE_MINUTES=60

# Optional API key for the AI coach added in a later phase.
LLM_API_KEY=
